// ==========================================================
// 🟢 FINANCE EMPIRE - PRISMA SCHEMA (MASTERPIECE EDITION)
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================
// 1. ПОЛЬЗОВАТЕЛИ И НАСТРОЙКИ
// ==========================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String?   @unique
  // --- НОВЫЕ ПОЛЯ ---
  phone         String?   @unique
  is_verified   Boolean   @default(false)
  verification_code String?
  code_expires_at   DateTime?
  // ------------------
  password_hash String
  role          String    @default("user")
  status        String    @default("active")
  last_login_at DateTime? @db.Timestamptz
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz

  settings      UserSettings?
  accounts      Account[]
  categories    Category[]
  counterparties Counterparty[]
  transactions  Transaction[]
  budgets       Budget[]
  debts         Debt[]
  recurring     RecurringTransaction[]
  goals         Goal[]
  notifications Notification[]
  admin_audit_logs AdminAuditLog[]
  sent_debt_requests     DebtRequest[]  @relation("SentDebtRequests")
  received_debt_requests DebtRequest[]  @relation("ReceivedDebtRequests")
  linked_debts_as_a      LinkedDebt[]   @relation("LinkedDebtsAsUserA")
  linked_debts_as_b      LinkedDebt[]   @relation("LinkedDebtsAsUserB")
  debt_activities        DebtActivity[]

  @@index([status])
  @@map("users")
}

model UserSettings {
  user_id        String   @id @db.Uuid
  base_currency  String   @default("UZS")
  // Храним курсы как JSON: {"USD": 12850, "EUR": 13500}
  currency_rates Json     @default("{\"UZS\": 1, \"USD\": 12850}")
  dark_mode      Boolean  @default(false)
  theme_color    String   @default("#2563eb")
  is_privacy_enabled Boolean @default(false)

  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz

  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ==========================================================
// 2. ФИНАНСОВЫЕ СУЩНОСТИ
// ==========================================================

model Account {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  name         String
  currency     String   @default("UZS")
  color        String   @default("#2563eb")
  icon         String   @default("💳")
  // В этой архитектуре мы храним баланс в таблице для скорости,
  // и обновляем его при каждой транзакции через API.
  balance      Decimal  @default(0) @db.Decimal(12, 2)
  is_hidden    Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Связи
  transactions Transaction[]
  recurring    RecurringTransaction[]

  @@map("accounts")
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  name         String
  type         String   // 'income', 'expense', 'transfer'
  icon         String   @default("🏷️")
  color        String   @default("#64748b")
  created_at   DateTime @default(now()) @db.Timestamptz

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Связи
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringTransaction[]

  @@map("categories")
}

model Counterparty {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  name         String
  type         String   @default("company") // 'person', 'company', 'organization'
  icon         String   @default("👤")
  color        String   @default("#64748b")
  is_favorite  Boolean  @default(false)
  phone        String?
  email        String?
  notes        String?
  created_at   DateTime @default(now()) @db.Timestamptz

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Связи
  transactions Transaction[]
  debts        Debt[]

  @@map("counterparties")
}

// ==========================================================
// 3. ТРАНЗАКЦИИ И БЮДЖЕТЫ
// ==========================================================

model Transaction {
  id              String   @id @default(uuid()) @db.Uuid
  user_id         String   @db.Uuid
  account_id      String   @db.Uuid
  category_id     String?  @db.Uuid
  counterparty_id String?  @db.Uuid

  amount          Decimal  @db.Decimal(12, 2)
  type            String   // 'income', 'expense', 'transfer_in', 'transfer_out'
  comment         String?
  date            DateTime @default(now()) @db.Timestamptz
  is_removed      Boolean  @default(false)
  removed_at      DateTime? @db.Timestamptz
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz

  // Связи
  user            User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account         Account       @relation(fields: [account_id], references: [id], onDelete: Cascade)
  category        Category?     @relation(fields: [category_id], references: [id])
  counterparty    Counterparty? @relation(fields: [counterparty_id], references: [id])

  // Индексы для ускорения поиска и сортировки в Истории
  @@index([user_id, date(sort: Desc)])
  @@index([user_id, is_removed])
  @@index([account_id])
  @@index([category_id])
  @@index([counterparty_id])
  @@index([user_id, type])
  @@index([user_id, category_id])
  @@index([user_id, counterparty_id])
  @@index([account_id, date(sort: Desc)])
  @@map("transactions")
}

model Budget {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  category_id String   @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  period      String   @default("month")
  created_at  DateTime @default(now()) @db.Timestamptz

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  // Уникальность: у юзера может быть только один бюджет на категорию в месяц
  @@unique([user_id, category_id, period])
  @@map("budgets")
}

// ==========================================================
// 4. ДОЛГИ, ЦЕЛИ И ПОДПИСКИ
// ==========================================================

model Debt {
  id              String    @id @default(uuid()) @db.Uuid
  user_id         String    @db.Uuid
  counterparty_id String?   @db.Uuid
  name            String
  amount          Decimal   @db.Decimal(12, 2)
  paid_amount     Decimal   @default(0) @db.Decimal(12, 2)
  type            String    // 'i_owe', 'owes_me'
  due_date        DateTime? @db.Date
  is_closed       Boolean   @default(false)
  is_removed      Boolean   @default(false)
  removed_at      DateTime? @db.Timestamptz
  notes           String?
  created_at      DateTime  @default(now()) @db.Timestamptz
  
  // Social Debt Fields
  linked_debt_id    String?     @db.Uuid
  is_linked         Boolean     @default(false)
  partner_user_id   String?     @db.Uuid

  user            User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  counterparty    Counterparty? @relation(fields: [counterparty_id], references: [id])
  linked_debt_a   LinkedDebt?   @relation("LinkedDebtA")
  linked_debt_b   LinkedDebt?   @relation("LinkedDebtB")

  @@index([user_id])
  @@index([user_id, is_removed])
  @@map("debts")
}

model RecurringTransaction {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  account_id   String?   @db.Uuid
  category_id  String?   @db.Uuid
  amount       Decimal   @db.Decimal(12, 2)
  type         String    // 'income', 'expense'
  frequency    String    @default("monthly")
  day_of_month Int
  comment      String?
  active       Boolean   @default(true)
  last_run     DateTime? @db.Timestamptz
  created_at   DateTime  @default(now()) @db.Timestamptz

  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account      Account?  @relation(fields: [account_id], references: [id])
  category     Category? @relation(fields: [category_id], references: [id])

  @@index([user_id, active])
  @@map("recurring_transactions")
}

model Goal {
  id             String    @id @default(uuid()) @db.Uuid
  user_id        String    @db.Uuid
  name           String
  target_amount  Decimal   @db.Decimal(12, 2)
  current_amount Decimal   @default(0) @db.Decimal(12, 2)
  deadline       DateTime? @db.Date
  icon           String    @default("🎯")
  color          String    @default("#2563eb")
  is_completed   Boolean   @default(false)
  is_removed     Boolean   @default(false)
  removed_at     DateTime? @db.Timestamptz
  created_at     DateTime  @default(now()) @db.Timestamptz
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz

  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("goals")
}

model Notification {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  title        String
  message      String
  type         String   @default("info") // 'success', 'warning', 'error', 'info'
  is_read      Boolean  @default(false)
  related_id   String?  @db.Uuid
  related_type String?
  created_at   DateTime @default(now()) @db.Timestamptz

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
  @@map("notifications")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  admin_id    String   @db.Uuid
  action      String
  target_type String?
  target_id   String?
  meta        Json?
  created_at  DateTime @default(now()) @db.Timestamptz

  admin User @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id, created_at(sort: Desc)])
  @@index([target_type, target_id])
  @@map("admin_audit_logs")
}

// ==========================================================
// 5. СОЦИАЛЬНЫЕ ДОЛГИ
// ==========================================================

model DebtRequest {
  id              String    @id @default(uuid()) @db.Uuid
  sender_id       String    @db.Uuid
  receiver_email  String
  receiver_id     String?   @db.Uuid
  
  amount          Decimal   @db.Decimal(12, 2)
  debt_type       String    // 'i_owe', 'owes_me' (from sender's perspective)
  name            String
  notes           String?
  due_date        DateTime? @db.Date
  
  status          String    @default("pending") // 'pending', 'accepted', 'rejected', 'cancelled', 'expired'
  rejection_reason String?
  
  linked_debt_id  String?   @db.Uuid
  
  created_at      DateTime  @default(now()) @db.Timestamptz
  responded_at    DateTime? @db.Timestamptz
  expires_at      DateTime? @db.Timestamptz
  
  // Visibility flags for soft delete
  sender_is_deleted   Boolean @default(false)
  receiver_is_deleted Boolean @default(false)
  
  sender          User       @relation("SentDebtRequests", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver        User?      @relation("ReceivedDebtRequests", fields: [receiver_id], references: [id], onDelete: Cascade)
  linked_debt     LinkedDebt? @relation(fields: [linked_debt_id], references: [id])
  
  @@index([receiver_email, status])
  @@index([sender_id, status])
  @@index([receiver_id, status])
  @@index([status, expires_at])
  @@map("debt_requests")
}

model LinkedDebt {
  id                String    @id @default(uuid()) @db.Uuid
  
  user_a_id         String    @db.Uuid
  debt_a_id         String    @db.Uuid @unique
  
  user_b_id         String    @db.Uuid
  debt_b_id         String    @db.Uuid @unique
  
  original_amount   Decimal   @db.Decimal(12, 2)
  current_amount    Decimal   @db.Decimal(12, 2)
  is_settled        Boolean   @default(false)
  
  created_at        DateTime  @default(now()) @db.Timestamptz
  settled_at        DateTime? @db.Timestamptz
  
  user_a            User      @relation("LinkedDebtsAsUserA", fields: [user_a_id], references: [id], onDelete: Cascade)
  user_b            User      @relation("LinkedDebtsAsUserB", fields: [user_b_id], references: [id], onDelete: Cascade)
  debt_a            Debt      @relation("LinkedDebtA", fields: [debt_a_id], references: [id], onDelete: Cascade)
  debt_b            Debt      @relation("LinkedDebtB", fields: [debt_b_id], references: [id], onDelete: Cascade)
  
  activities        DebtActivity[]
  requests          DebtRequest[]
  
  @@index([user_a_id, is_settled])
  @@index([user_b_id, is_settled])
  @@map("linked_debts")
}

model DebtActivity {
  id              String     @id @default(uuid()) @db.Uuid
  linked_debt_id  String     @db.Uuid
  user_id         String     @db.Uuid
  
  action_type     String     // 'created', 'payment', 'settled', 'edited', 'note_added'
  amount          Decimal?   @db.Decimal(12, 2)
  note            String?
  metadata        Json?
  
  created_at      DateTime   @default(now()) @db.Timestamptz
  
  linked_debt     LinkedDebt @relation(fields: [linked_debt_id], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([linked_debt_id, created_at(sort: Desc)])
  @@map("debt_activities")
}
